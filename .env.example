# ==============================================================================
# DeutschUp Frontend - Environment Variables Configuration
# ==============================================================================

# Backend API Base URL
# - Local Development: http://localhost:3000/api
# - Production: https://<your-backend-domain>/api (or https://<your-backend-domain>)
# IMPORTANT: On Vercel / Netlify / Render, add this variable in Project Settings -> Environment Variables,
# then trigger a Redeploy (Clear build cache recommended) so Vite bakes it in at build time.
VITE_API_URL=http://localhost:3000/api

# Google OAuth Client ID (optional if Google login is enabled)
VITE_GOOGLE_CLIENT_ID=384261892677-gmo0ekl5squascpjmelluaev17i91gpu.apps.googleusercontent.com

# Socket.IO Server URL (optional, defaults to VITE_API_URL with '/api' stripped)
# VITE_SOCKET_URL=http://localhost:3000
